# ==========================================
# LEARNORBIT APPLICATION ENVIRONMENT TEMPLATE
# ==========================================

# Frontend (Vite) API Base URL (Set on Vercel to your deployed Render backend URL)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Backend PostgreSQL Database (Set on Render)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@host:5432/student_career

# Google Gemini API Key (Set on Render)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Production Security (Set on Render)
ENVIRONMENT=production
AUTH_REQUIRED=true
CORS_ORIGINS=https://your-frontend.vercel.app
