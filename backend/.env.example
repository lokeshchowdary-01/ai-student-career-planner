# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to backend/.env and replace placeholders with your actual values.
# NEVER commit real passwords or API keys to version control.

# PostgreSQL 16 Database Connection URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/student_career

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# AI Provider and Model Selection
AI_PROVIDER=google-gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Allowed CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://localhost:5173

# Application Environment (development | production)
ENVIRONMENT=development

# Secret key for session security
SECRET_KEY=change_this_to_a_random_32_byte_secret_in_production
